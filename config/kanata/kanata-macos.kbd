;; list of key names can be found in https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs

(defvar
  repress-time       200
  hold-time          200
  quick-hold-time    120
  hrm-idle-ms        90
  chord-time         80

  left-hand-keys   (q w e r t a s d f g z x c v b)
  right-hand-keys  (y u i o p h j k l ; n m , . /)

  left-hand-press    (q w e r t z x c v b)
  right-hand-press   (y u i o p n m , . /)
  left-hand-release  (a s d f g)
  right-hand-release (h j k l ;)
)

(defcfg
  concurrent-tap-hold yes
)

(deffakekeys
  to-base (layer-switch qwerty)
)

(defsrc
  f13
  esc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt  lmet          spc            ralt rmet rctl
)
(deflayer qwerty
  @f13
  @esc
  _    _    _    _    _    _    _    _    _    _    _    _
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    bspc ]   \
  @cap @a   @s   @d   @f   g    h    @j   @k   @l   @;   @quo ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt lmet           @spc-arr            ralt @nav rctl
)

;; auto-entered while typing: identical to qwerty but home row is plain letters
(deflayer nomods
  @f13
  @esc
  _    _    _    _    _    _    _    _    _    _    _    _
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    bspc ]   \
  @cap a    s    d    f    g    h    j    k    l    ;    @quo ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt lmet           @spc-arr            ralt @nav rctl
)

(deflayer navigation
  f13
  esc
  _    _    _    _    _    _    _    _    _    _    _    _
  grv  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  bspc
  tab  q   up   e    lrld t    y    u    i    o    p    [    ]   \
  @cw  @a   @s   @d   @f   g    left @nav-j @nav-k @nav-l @nav-scln ret  ret
  lsft z    x    c    v    b     n    m  ,    .    /    rsft
  _    lctl lalt lmet           spc            ralt rmet rctl
)

(deflayer symbol
  f13
  esc
  _    _    _    _    _    _    _    _    _    _    _    _
  grv  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  bspc
  grv  S-1  S-2  S-3  S-4  S-5  del  7    8    9    +    @navlbr ]   \
  @cap @sym-a @sym-s @sym-d @sym-f =    bspc @sym-j @sym-k @sym-l @sym-scln . ret
  lsft z    x    c    v    b    0    1    2    3    \    rsft
  _    lctl lalt lmet           @spc-arr            ralt rmet rctl
)

(defalias
  tap     (multi
            (layer-switch nomods)
            (on-idle-fakekey to-base tap $hrm-idle-ms))
  cap     (tap-hold-press $repress-time $hold-time esc lctl)
  tab     (tap-hold-release $repress-time $hold-time tab (layer-while-held navigation))
  quo     (tap-hold-release $repress-time $hold-time ' rctl)
  navlbr  (tap-hold-release $repress-time $hold-time del ralt)
  scln    (tap-hold-release $repress-time $hold-time ; rmet)
  spc-arr (tap-hold-release $repress-time $hold-time (multi spc @tap) (layer-while-held symbol))
  esc     (tap-hold-release $repress-time $quick-hold-time grv (layer-while-held symbol))
  cw      (caps-word 2000)
  nav     (tap-hold-release $repress-time $hold-time (multi ret @tap) (layer-while-held navigation))
  f13     @nav
)

(defalias
  a (tap-hold-release-tap-keys-release $repress-time $hold-time (multi a @tap) lmet $left-hand-press $left-hand-release)
  s (tap-hold-release-tap-keys-release $repress-time $hold-time (multi s @tap) lalt $left-hand-press $left-hand-release)
  d (tap-hold-release-tap-keys-release $repress-time $hold-time (multi d @tap) lsft $left-hand-press $left-hand-release)
  f (tap-hold-release-tap-keys-release $repress-time $hold-time (multi f @tap) lctl $left-hand-press $left-hand-release)
  j (tap-hold-release-tap-keys-release $repress-time $hold-time (multi j @tap) rctl $right-hand-press $right-hand-release)
  k (tap-hold-release-tap-keys-release $repress-time $hold-time (multi k @tap) rsft $right-hand-press $right-hand-release)
  l (tap-hold-release-tap-keys-release $repress-time $hold-time (multi l @tap) ralt $right-hand-press $right-hand-release)
  ; (tap-hold-release-tap-keys-release $repress-time $hold-time (multi ; @tap) rmet $right-hand-press $right-hand-release)
)

;; HRM for navigation/symbol layers: tap outputs the layer's own action,
;; hold outputs the same modifier as the corresponding base-layer HRM key,
;; so holding still works whether the layer switch or the key press comes first.
(defalias
  nav-j    (tap-hold-release-tap-keys-release $repress-time $hold-time down  rctl $right-hand-press $right-hand-release)
  nav-k    (tap-hold-release-tap-keys-release $repress-time $hold-time up    rsft $right-hand-press $right-hand-release)
  nav-l    (tap-hold-release-tap-keys-release $repress-time $hold-time right ralt $right-hand-press $right-hand-release)
  nav-scln (tap-hold-release-tap-keys-release $repress-time $hold-time ;     rmet $right-hand-press $right-hand-release)
)

(defalias
  sym-a    (tap-hold-release-tap-keys-release $repress-time $hold-time S-6 lmet $left-hand-press  $left-hand-release)
  sym-s    (tap-hold-release-tap-keys-release $repress-time $hold-time S-7 lalt $left-hand-press  $left-hand-release)
  sym-d    (tap-hold-release-tap-keys-release $repress-time $hold-time S-8 lsft $left-hand-press  $left-hand-release)
  sym-f    (tap-hold-release-tap-keys-release $repress-time $hold-time -   lctl $left-hand-press  $left-hand-release)
  sym-j    (tap-hold-release-tap-keys-release $repress-time $hold-time 4   rctl $right-hand-press $right-hand-release)
  sym-k    (tap-hold-release-tap-keys-release $repress-time $hold-time 5   rsft $right-hand-press $right-hand-release)
  sym-l    (tap-hold-release-tap-keys-release $repress-time $hold-time 6   ralt $right-hand-press $right-hand-release)
  sym-scln (tap-hold-release-tap-keys-release $repress-time $hold-time -   rmet $right-hand-press $right-hand-release)
)

(defchordsv2
  (r t) S-9 $chord-time all-released (navigation symbol)
  (y u) S-0 $chord-time all-released (navigation symbol)
  (f g) [   $chord-time all-released (navigation symbol)
  (h j) ]   $chord-time all-released (navigation symbol)
  (v b) S-[ $chord-time all-released (navigation symbol)
  (n m) S-] $chord-time all-released (navigation symbol)
  (m ,) esc $chord-time all-released (navigation symbol)
  (, .) ret $chord-time all-released (navigation symbol)
)
