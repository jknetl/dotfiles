;; list of key names can be found in https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs

(defvar
  repress-time       200
  hold-time          200
  quick-hold-time    100
  hrm-idle-ms        90
  chord-time         80

  left-hand-keys   (q w e r t a s d f g z x c v b)
  right-hand-keys  (y u i o p h j k l ; n m , . /)

  left-hand-press    (q w e r t z x c v b)
  right-hand-press   (y u i o p n m , . /)
  left-hand-release  (a s d f g)
  right-hand-release (h j k l ;)
)

(defcfg
  concurrent-tap-hold yes
)

(deffakekeys
  to-base (layer-switch qwerty)
)

(defsrc
  f13
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet  lalt          spc            ralt rmet rctl
)

(deflayer qwerty
  @f13
  @esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    bspc ]   \
  @cap @a   @s   @d   @f   g    h    @j   @k   @l   @;   @quo ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           @spc-arr            @nav rmet rctl
)

;; auto-entered while typing: identical to qwerty but home row is plain letters
(deflayer nomods
  @f13
  @esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    bspc ]   \
  @cap a    s    d    f    g    h    j    k    l    ;    @quo ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           @spc-arr            @nav rmet rctl
)

(deflayer navigation
  f13
  esc
  grv  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  bspc
  tab  q   up   e    lrld t    y    u    i    o    p    [    ]   \
  @cw  @a   @s   @d   @f   g    left down up right  ; ret  ret
  lsft z    x    c    v    b     n    m  ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer symbol
  f13
  esc
  grv  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  bspc
  grv  q    w    e    r    t    del  7    8    9    -    @navlbr ]   \
  @cap @a   @s   @d   @f   =    bspc 4    5    6    ret  @quo ret
  lsft z    x    c    v    b    0    1    2    3    \    rsft
  lctl lmet lalt           @spc-arr            ralt rmet rctl
)

(defalias
  tap     (multi
            (layer-switch nomods)
            (on-idle-fakekey to-base tap $hrm-idle-ms))
  cap     (tap-hold-release $repress-time $hold-time esc lctl)
  quo     (tap-hold-release $repress-time $hold-time ' rctl)
  navlbr  (tap-hold-release $repress-time $hold-time del rmet)
  scln    (tap-hold-release $repress-time $hold-time ; ralt)
  spc-arr (tap-hold-release $repress-time $hold-time (multi spc @tap) (layer-while-held symbol))
  esc     (tap-hold-release $repress-time $quick-hold-time grv (layer-while-held symbol))
  cw      (caps-word 2000)
  nav     (tap-hold-release $repress-time $hold-time (multi ret @tap) (layer-while-held navigation))
  f13     @nav
)

(defalias
  a (tap-hold-release-tap-keys-release $repress-time $hold-time (multi a @tap) lalt $left-hand-press $left-hand-release)
  s (tap-hold-release-tap-keys-release $repress-time $hold-time (multi s @tap) lmet $left-hand-press $left-hand-release)
  d (tap-hold-release-tap-keys-release $repress-time $hold-time (multi d @tap) lsft $left-hand-press $left-hand-release)
  f (tap-hold-release-tap-keys-release $repress-time $hold-time (multi f @tap) lctl $left-hand-press $left-hand-release)
  j (tap-hold-release-tap-keys-release $repress-time $hold-time (multi j @tap) rctl $right-hand-press $right-hand-release)
  k (tap-hold-release-tap-keys-release $repress-time $hold-time (multi k @tap) rsft $right-hand-press $right-hand-release)
  l (tap-hold-release-tap-keys-release $repress-time $hold-time (multi l @tap) rmet $right-hand-press $right-hand-release)
  ; (tap-hold-release-tap-keys-release $repress-time $hold-time (multi ; @tap) ralt $right-hand-press $right-hand-release)
)

(defchordsv2
  (r t) S-9 $chord-time all-released (navigation symbol)
  (y u) S-0 $chord-time all-released (navigation symbol)
  (f g) [   $chord-time all-released (navigation symbol)
  (h j) ]   $chord-time all-released (navigation symbol)
  (v b) S-[ $chord-time all-released (navigation symbol)
  (n m) S-] $chord-time all-released (navigation symbol)
  (m ,) esc $chord-time all-released (navigation symbol)
  (, .) ret $chord-time all-released (navigation symbol)
)
