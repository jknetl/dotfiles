;; list of key names can be found in https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs

(defvar
  repress-time       200
  hold-time          200
  quick-hold-time    100
  chord-time         80

  ;; Per-finger HRM tuning, copied from the ZMK keymap (zmk_mylayout_5.4.keymap):
  ;; tt-* = tapping-term-ms, idle-* = require-prior-idle-ms, quick-tap = quick-tap-ms
  tt-index           190
  tt-middy           210
  tt-ring            210
  tt-pinky           260
  idle-index         100
  idle-other         150
  quick-tap          300
)

;; Physical hand assignment for tap-hold-opposite-hand (needs kanata >= 1.12.0).
;; Mirrors ZMK's hold-trigger-key-positions: only an opposite-hand key can turn a
;; home-row key into a modifier; same-hand keys always resolve as a tap.
;; Thumb keys (spc, f13) are neutral and trigger the hold from either hand,
;; like the thumb positions in ZMK's trigger lists.
(defhands
  (left  esc grv 1 2 3 4 5 tab q w e r t caps a s d f g lsft z x c v b lctl lmet lalt)
  (right 6 7 8 9 0 - = bspc y u i o p [ ] \ h j k l ; ' ret n m , . / rsft ralt rmet rctl)
)

(defcfg
  concurrent-tap-hold yes
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
  )
)

(defsrc
  f13
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet  lalt          spc            ralt rmet rctl
)

(deflayer qwerty
  @f13
  @esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    bspc ]   \
  @cap @a   @s   @d   @f   g    h    @j   @k   @l   @;   @quo ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           @spc-arr            @sym  @nav rctl
)

(deflayer navigation
  f13
  esc
  grv  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  bspc
  tab  q   up   e    lrld t    y    u    i    o    p    [    ]   \
  @cw  @a   @s   @d   @f   g    left j    k    l    ;     ret  ret
  lsft z    x    c    v    b     n    m  ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer symbol
  f13
  esc
  grv  f1   f2   f3   f4   f5   f6   f7   /    S-8  S-=  del  =    bspc
  grv  S-1  S-2  S-3  S-4  S-5  del  7    8    9    -    @navlbr ]   \
  @cap a    s    d    f    S-0  bspc @sym-j @sym-k @sym-l @sym-scln . ret
  lsft grv  -    =    [    ]    0    1    2    3    \    rsft
  lctl lmet lalt           @spc-arr            ralt rmet rctl
)

(defalias
  cap    (tap-hold-press $repress-time $hold-time esc lctl)
  tab     (tap-hold-release $repress-time $hold-time tab (layer-while-held navigation))
  quo     (tap-hold-release $repress-time $hold-time ' rctl)
  navlbr  (tap-hold-release $repress-time $hold-time del rmet)
  scln    (tap-hold-release $repress-time $hold-time ; ralt)
  spc-arr (tap-hold-release $repress-time $hold-time spc (layer-while-held navigation))
  esc     (tap-hold-release $repress-time $quick-hold-time grv (layer-while-held symbol))
  cw      (caps-word 2000)
  nav     (tap-hold-release $repress-time $hold-time ret (layer-while-held navigation))
  sym     (tap-hold-release $repress-time $hold-time ret (layer-while-held symbol))
  f13     @nav
)

(defalias
  ;; Home row mods, modeled on ZMK's tap-preferred hold-tap with hold-trigger-on-release:
  ;;  - opposite-hand key pressed AND released while held -> modifier (hold-trigger-on-release)
  ;;  - same-hand key pressed                              -> letter (positional hold-tap)
  ;;  - held past the per-finger tapping term              -> modifier (tap-preferred timeout)
  ;;  - typed within idle-* ms after another key           -> letter (require-prior-idle-ms)
  ;;  - tapped then re-pressed within quick-tap ms         -> letter again (quick-tap-ms)
  a (tap-hold-opposite-hand-release $tt-pinky a lalt
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  s (tap-hold-opposite-hand-release $tt-ring s lmet
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  d (tap-hold-opposite-hand-release $tt-middy d lctl
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  f (tap-hold-opposite-hand-release $tt-index f lsft
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-index) (tap-repress-timeout $quick-tap))
  j (tap-hold-opposite-hand-release $tt-index j rsft
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-index) (tap-repress-timeout $quick-tap))
  k (tap-hold-opposite-hand-release $tt-middy k rctl
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  l (tap-hold-opposite-hand-release $tt-ring l rmet
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  ; (tap-hold-opposite-hand-release $tt-pinky ; ralt
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
)

(defalias
  sym-j (tap-hold-opposite-hand-release $tt-index 4 rsft
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-index) (tap-repress-timeout $quick-tap))
  sym-k (tap-hold-opposite-hand-release $tt-middy 5 rctl
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  sym-l (tap-hold-opposite-hand-release $tt-ring 6 rmet
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
  sym-scln (tap-hold-opposite-hand-release $tt-pinky - ralt
    (timeout hold) (same-hand tap) (neutral-keys spc f13) (neutral hold)
    (require-prior-idle $idle-other) (tap-repress-timeout $quick-tap))
)


(defchordsv2
  (r t) S-9 $chord-time all-released (navigation symbol)
  (y u) S-0 $chord-time all-released (navigation symbol)
  (f g) [   $chord-time all-released (navigation symbol)
  (h j) ]   $chord-time all-released (navigation symbol)
  (v b) S-[ $chord-time all-released (navigation symbol)
  (n m) S-] $chord-time all-released (navigation symbol)
  (m ,) esc $chord-time all-released (navigation symbol)
  (, .) ret $chord-time all-released (navigation symbol)
  (x c) -   $chord-time all-released (navigation symbol)
)
