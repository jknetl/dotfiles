theme = Catppuccin Mocha
font-family = "MesloLGS NF"
font-size = 12
confirm-close-surface = false
command = /usr/bin/nu

window-decoration = server

# Free up ctrl+, (used by zellij) instead of opening config in editor
keybind = ctrl+,=unbind

# Reload config with ctrl+shift+r instead of default ctrl+shift+, (collides with herdr shortcut)
keybind = ctrl+shift+,=unbind
keybind = ctrl+shift+r=reload_config


config-file = ?config-mac
