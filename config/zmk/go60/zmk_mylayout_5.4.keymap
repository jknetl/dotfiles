        combo_esc {
            key-positions = <POS_RH_C2R4 POS_RH_C3R4>;
            bindings = <&kp ESC>;
        };

        combo_cv {
            key-positions = <POS_LH_C3R4 POS_LH_C2R4>;
            bindings = <&kp MINUS>;
        };
    };
};

